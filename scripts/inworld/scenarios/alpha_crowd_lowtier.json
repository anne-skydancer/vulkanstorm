    "post_login_s": 20.0,
    "after_camera_s": 4.0,
    "after_teleport_s": 30.0,
    "login_timeout_s": 3600,
    "window_timeout_s": 180.0,
    "compare_wait_s": 6.0,
    "after_setting_s": 4.0
  },
