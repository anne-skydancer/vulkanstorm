<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
  name="panel_login">
  <panel.string
    name="forgot_password_url">
		http://secondlife.com/account/request.php?lang=fr
	</panel.string>
  <string
    name="ServerComboTooltip">
		Une grille connue ou l'URI d'une grille
	</string>
  <layout_stack
    name="main_stack">
    <layout_panel
      name="center_stage">
      <layout_stack
        name="ui_stack">
        <layout_panel
          name="ui_container">
          <panel
            name="login">
            <combo_box
              name="username_combo"
              label="Nom de résident(e) :"
              tool_tip="Le nom de compte que vous avez choisi lors de votre inscription, par exemple, bobsmith420 ou Steller Sunshine" />
            <check_box
              label="Enr. le nom"
              name="remember_username_check" />
            <button
              tool_tip="Supprimer ce nom de résident(e)"
              name="remove_user_btn" />
            <line_editor
              name="password_edit"
              label="Mot de passe" />
            <button
              name="password_show_btn"
              tool_tip="Afficher le mot de passe" />
            <button
              name="password_hide_btn"
              tool_tip="Masquer le mot de passe" />
            <check_box
              label="Enr. le mot de passe"
              name="remember_check" />
          </panel>
          <layout_stack
            name="login_stack">
            <layout_panel
              name="start_location_panel">
              <combo_box
                name="start_location_combo"
                label="Démarrer :">
                <combo_box.item
                  label="Dernier emplacement"
                  name="MyLastLocation" />
                <combo_box.item
                  label="Mon domicile"
                  name="MyHome" />
                <combo_box.item
                  label="&lt;Saisissez le nom de la région&gt;"
                  name="Typeregionname" />
              </combo_box>
            </layout_panel>
            <layout_panel
              name="grid_panel">
              <text
                name="grid_login_text"
                width="55">
								Grille :
							</text>
              <text
                name="grid_builder_text">
								+ Ajouter des grilles
							</text>
            </layout_panel>
            <layout_panel
              name="mode_selection">
              <text
                name="mode_selection_text">
								Mode :
							</text>
              <combo_box
                name="mode_combo"
                tool_tip="Sélectionnez quel style de client vous sied le mieux pour régler vos paramètres par défaut de manière appropriée.">
                <combo_box.item
                  label="Hybride"
                  name="Hybrid" />
                <combo_box.item
                  label="Texte"
                  name="Text" />
              </combo_box>
            </layout_panel>
            <layout_panel
              name="login_actions">
              <button
                label="Connexion"
                name="connect_btn" />
              <text
                name="create_new_account_text">
				S'enregistrer
			</text>
              <text
                name="forgot_password_text">
				Identifiants oubliés ?
			</text>
            </layout_panel>
          </layout_stack>
        </layout_panel>
      </layout_stack>
    </layout_panel>
  </layout_stack>
</panel>
