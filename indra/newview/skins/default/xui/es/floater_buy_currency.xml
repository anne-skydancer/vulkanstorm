<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="buy currency" title="COMPRAR L$">
    <floater.string name="buy_currency">Comprar [LINDENS] L$ por, aprox., [LOCALAMOUNT]</floater.string>
    <floater.string name="info_cannot_buy">No se pudo hacer la compra</floater.string>
    <layout_stack name="outer_stack">
        <layout_panel name="layout_panel_title">
            <text name="info_need_more">Necesitas más L$</text>
            <text name="info_buying">Comprar L$</text>
        </layout_panel>
        <layout_panel name="layout_panel_balance">
            <text name="balance_label">Tengo</text>
            <text name="balance_amount">[AMT] L$</text>
        </layout_panel>
        <layout_panel name="layout_panel_action">
            <text name="currency_action">Quiero comprar</text>
            <text name="currency_label">L$</text>
            <line_editor name="currency_amt" label="L$">1234</line_editor>
            <text name="currency_est">aprox. [LOCALAMOUNT]</text>
            <text name="getting_data">Calculando...</text>
            <text name="total_label">Mi nuevo saldo será</text>
            <text name="total_amount">[AMT] L$</text>
        </layout_panel>
        <layout_panel name="layout_panel_msg">
            <text name="currency_links">[http://www.secondlife.com/my/account/payment_method_management.php método de pago] | [http://www.secondlife.com/my/account/currency.php moneda]</text>
            <text name="exchange_rate_note">Vuelve a escribir la cantidad para ver el tipo de cambio más reciente.</text>
            <text name="purchase_warning_repurchase">Confirmando que con esta compra sólo se compran L$,
no el objeto.</text>
        </layout_panel>
        <layout_panel name="layout_panel_buttons">
            <text name="contacting">Contactando con el LindeX...</text>
            <button name="buy_btn" label="Comprar ahora" />
            <button name="cancel_btn" label="Cancelar" />
        </layout_panel>
    </layout_stack>
</floater>
