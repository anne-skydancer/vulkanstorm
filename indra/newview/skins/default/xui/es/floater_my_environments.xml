<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater label="Lugares" name="my_environments" title="MIS ENTORNOS">
    <layout_stack name="main_layout">
        <layout_panel name="filter_panel" label="Filtros">
            <check_box name="chk_days" label="Días" />
            <check_box name="chk_skies" label="Cielos" />
            <check_box name="chk_water" label="Agua" />
            <filter_editor name="flt_search" label="Filtrar entornos" />
        </layout_panel>
        <layout_panel name="list_panel" label="Entornos">
            <panel name="pnl_inv_wrap" label="pnl_inv_wrap" />
        </layout_panel>
        <layout_panel name="lp_showfolders">
            <check_box name="chk_showfolders" initial_value="false" label="Mostrar todas las carpetas" />
        </layout_panel>
        <layout_panel name="pnl_control">
            <panel name="pnl_bottom" label="bottom_panel">
                <menu_button name="btn_gear" tool_tip="Más opciones" />
                <menu_button name="btn_newsettings" tool_tip="Crear una opción nueva" />
                <button name="btn_del" tool_tip="Quitar el ítem seleccionado" />
            </panel>
        </layout_panel>
    </layout_stack>
</floater>
