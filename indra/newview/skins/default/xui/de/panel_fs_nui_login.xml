<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
  name="panel_login">
  <panel.string
    name="forgot_password_url">
		http://secondlife.com/account/request.php?lang=de
	</panel.string>
  <string
    name="ServerComboTooltip">
		Ein bekanntes Grid oder eine Grid-URI
	</string>
  <layout_stack
    name="main_stack">
    <layout_panel
      name="center_stage">
      <layout_stack
        name="ui_stack">
        <layout_panel
          name="ui_container">
          <panel
            name="login">
            <combo_box
              name="username_combo"
              label="Benutzername"
              tool_tip="Bei der Registrierung gewählter Benutzername wie „berndschmidt12“ oder „Liebe Sonne“" />
            <check_box
              label="Benutzername speichern"
              name="remember_username_check" />
            <button
              tool_tip="Diesen Benutzernamen löschen"
              name="remove_user_btn" />
            <line_editor
              name="password_edit"
              label="Kennwort" />
            <button
              name="password_show_btn"
              tool_tip="Passwort anzeigen" />
            <button
              name="password_hide_btn"
              tool_tip="Passwort verstecken" />
            <check_box
              label="Kennwort speichern"
              name="remember_check" />
          </panel>
          <layout_stack
            name="login_stack">
            <layout_panel
              name="start_location_panel">
              <combo_box
                name="start_location_combo"
                label="Hier starten:">
                <combo_box.item
                  label="Letzter Standort"
                  name="MyLastLocation" />
                <combo_box.item
                  label="Zuhause"
                  name="MyHome" />
                <combo_box.item
                  label="&lt;Region eingeben&gt;"
                  name="Typeregionname" />
              </combo_box>
            </layout_panel>
            <layout_panel
              name="grid_panel">
              <text
                name="grid_login_text">
								Grid:
							</text>
              <text
                name="grid_builder_text">
								+ Klicken um Grids hinzuzufügen
							</text>
            </layout_panel>
            <layout_panel
              name="mode_selection">
              <text
                name="mode_selection_text">
								Modus:
							</text>
              <combo_box
                name="mode_combo"
                tool_tip="Wählen Sie, welcher Viewer-Style Ihnen am meisten vertraut ist, um die Standards Ihren Bedürfnissen anzupassen.">
                <combo_box.item
                  label="Hybrid"
                  name="Hybrid" />
                <combo_box.item
                  label="Text"
                  name="Text" />
              </combo_box>
            </layout_panel>
            <layout_panel
              name="login_actions">
              <button
                label="Anmelden"
                name="connect_btn" />
              <text
                name="create_new_account_text">
				Registrieren
			</text>
              <text
                name="forgot_password_text">
				Kennwort vergessen?
			</text>
            </layout_panel>
          </layout_stack>
        </layout_panel>
      </layout_stack>
    </layout_panel>
  </layout_stack>
</panel>
