<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
  name="panel_login" >
  <string
    name="ServerComboTooltip" >
Существующая сетка или URI сетки
  </string>
  <layout_stack
    name="main_stack" >
    <layout_panel
      name="center_stage" >
      <layout_stack
        name="ui_stack" >
        <layout_panel
          name="ui_container" >
          <scroll_container
            name="login_scroll" >
            <panel
              name="login_content" >
              <panel
                name="login" >
                <combo_box
                  label="Пользователь"
                  name="username_combo"
                  tool_tip="Имя пользователя, которое вы выбирали при регистрации, например: bobsmith12 или Stellar Sunshine" />
                <check_box
                  label="Запомнить пользователя"
                  name="remember_username_check" />
                <button
                  tool_tip="Удалить это Имя пользователя"
                  label=""
                  name="remove_user_btn" />
                <line_editor
                  name="password_edit"
                  label="Пароль" />
                <button
                  name="password_show_btn"
                  tool_tip="Показать текст пароля" />
                <button
                  name="password_hide_btn"
                  tool_tip="Скрыть текст пароляt" />
                <check_box
                  label="Запомнить пароль"
                  name="remember_check" />
                <text name="username_text">Пользователь</text>
                <text name="password_text">Пароль</text>
              </panel>
              <layout_stack
                name="login_stack" >
                <layout_panel
                  name="start_location_panel" >
                  <combo_box
                    label="Стартовое место"
                    name="start_location_combo" >
                    <combo_box.item
                      label="Прошлое место"
                      name="MyLastLocation" />
                    <combo_box.item
                      label="Мой Дом"
                      name="MyHome" />
                    <combo_box.item
                      label="&lt;Ввести название региона&gt;"
                      name="Typeregionname" />
                  </combo_box>
                  <text name="start_location_text">Стартовое место</text>
                </layout_panel>
                <layout_panel
                  name="grid_panel" >
                  <text name="grid_login_text" width="45">Сеть:</text>
                  <text name="grid_builder_text" width="300">+ Нажмите чтобы добавить больше сеток</text>
                </layout_panel>
                <layout_panel
                  name="mode_selection" >
                  <text name="mode_selection_text">Режим:</text>
                  <combo_box
                    name="mode_combo"
                    tool_tip="Выберите стиль просмотра, с которым вы наиболее знакомы, чтобы правильно установить значения по умолчанию." >

              </combo_box>
                </layout_panel>
                <layout_panel
                  name="login_actions" >
                  <button
                    label="Войти"
                    name="connect_btn" />
                  <text name="create_new_account_text">Создать аккаунт</text>
                  <text name="forgot_password_text">Забыли пароль?</text>
                </layout_panel>
              </layout_stack>
            </panel>
          </scroll_container>
        </layout_panel>
      </layout_stack>
    </layout_panel>
  </layout_stack>
</panel>
