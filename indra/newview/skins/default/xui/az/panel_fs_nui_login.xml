<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
  name="panel_login" >
  <string
    name="ServerComboTooltip" >
Mövcud grid və ya grid URL-si
  </string>
  <layout_stack
    name="main_stack" >
    <layout_panel
      name="center_stage" >
      <layout_stack
        name="ui_stack" >
        <layout_panel
          name="ui_container" >
          <scroll_container
            name="login_scroll" >
            <panel
              name="login_content" >
              <panel
                name="login" >
                <combo_box
                  label="İstifadəçi"
                  name="username_combo"
                  tool_tip="Qeydiyyatda istifadə etdiyiniz istifadəçi adı, məsələn: dabandashi50 və ya Ertogrul Khazarli" />
                <check_box
                  label="İstifadəçini yadda saxla"
                  name="remember_username_check" />
                <button
                  tool_tip="Bu istifadəçi adını sil"
                  label=""
                  name="remove_user_btn" />
                <line_editor
                  name="password_edit"
                  label="Şifrə" />
                <check_box
                  label="Şifrəni yadda saxla"
                  name="remember_check" />
                <text name="username_text">İstifadəçi</text>
                <text name="password_text">Şifrə</text>
              </panel>
              <layout_stack
                name="login_stack" >
                <layout_panel
                  name="start_location_panel" >
                  <combo_box
                    label="Başlanğıc yeri"
                    name="start_location_combo" >
                    <combo_box.item
                      label="Keçmiş yer"
                      name="MyLastLocation" />
                    <combo_box.item
                      label="Evim"
                      name="MyHome" />
                    <combo_box.item
                      label="&lt;Region adını daxil edin&gt;"
                      name="Typeregionname" />
                  </combo_box>
                  <text name="start_location_text">Başlanğıc yeri</text>
                </layout_panel>
                <layout_panel
                  name="grid_panel" >
                  <text name="grid_login_text" width="45">Grid:</text>
                </layout_panel>
                <layout_panel
                  name="mode_selection" >
                  <text name="mode_selection_text">Rejim:</text>
                  <combo_box
                    name="mode_combo"
                    tool_tip="Defolt seçimlərini düzgün qurmaq üçün ən çox tanış olduğunuz baxış tərzini seçin." >

              </combo_box>
                </layout_panel>
                <layout_panel
                  name="login_actions" >
                  <button
                    label="Daxil ol"
                    name="connect_btn" />
                  <text name="create_new_account_text">Hesab yarat</text>
                  <text name="forgot_password_text">Şifrəni unutdunuz?</text>
                </layout_panel>
              </layout_stack>
            </panel>
          </scroll_container>
        </layout_panel>
      </layout_stack>
    </layout_panel>
  </layout_stack>
</panel>
