<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_login">
  <panel.string name="forgot_password_url">http://secondlife.com/account/request.php?lang=pt</panel.string>
  <string name="ServerComboTooltip">Uma grade conhecida ou uma URI de grade</string>
  <layout_stack name="main_stack">
    <layout_panel name="center_stage">
      <layout_stack name="ui_stack">
        <layout_panel name="ui_container">
          <scroll_container name="login_scroll">
            <panel name="login_content">
              <panel name="login">
                <text name="password_text">Senha</text>
                <text name="username_text">Nome de usuário</text>
                <combo_box name="username_combo" label="Nome de usuário" tool_tip="Nome de usuário escolhido no cadastro, como &quot;berndschmidt12&quot; ou &quot;Love Sun&quot;" />
                <check_box name="remember_username_check" label="Salvar nome de usuário" />
                <button name="remove_user_btn" tool_tip="Excluir este nome de usuário" />
                <line_editor name="password_edit" label="Senha" />
                <button name="password_show_btn" tool_tip="Mostrar senha" />
                <button name="password_hide_btn" tool_tip="Ocultar senha" />
                <check_box name="remember_check" label="Salvar senha" />
              </panel>
              <layout_stack name="login_stack">
                <layout_panel name="start_location_panel">
                  <text name="start_location_text">Iniciar em</text>
                  <combo_box name="start_location_combo" label="Iniciar em:">
                    <combo_box.item name="MyLastLocation" label="Última localização" />
                    <combo_box.item name="MyHome" label="Casa" />
                    <combo_box.item name="Typeregionname" label="&lt;digite uma região&gt;" />
                  </combo_box>
                </layout_panel>
                <layout_panel name="grid_panel">
                  <text name="grid_login_text">Grade:</text>
                  <text name="grid_builder_text">+ Clique para adicionar grades</text>
                </layout_panel>
                <layout_panel name="mode_selection">
                  <text name="mode_selection_text">Modo:</text>
                  <combo_box name="mode_combo" tool_tip="Escolha o estilo de viewer que você conhece melhor para ajustar os padrões às suas necessidades.">
                    <combo_box.item name="Hybrid" label="Hibrido" />
                    <combo_box.item name="Text" label="Texto" />
                  </combo_box>
                </layout_panel>
                <layout_panel name="login_actions">
                  <button name="connect_btn" label="Entrar" />
                  <text name="create_new_account_text">Criar conta</text>
                  <text name="forgot_password_text">Esqueceu a senha?</text>
                </layout_panel>
              </layout_stack>
            </panel>
          </scroll_container>
        </layout_panel>
      </layout_stack>
    </layout_panel>
  </layout_stack>
</panel>
