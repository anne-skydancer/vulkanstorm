<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater label="Lugares" name="my_environments" title="MEUS AMBIENTES">
    <layout_stack name="main_layout">
        <layout_panel name="filter_panel" label="Filtros">
            <check_box name="chk_days" label="Dias" />
            <check_box name="chk_skies" label="Céus" />
            <check_box name="chk_water" label="Água" />
            <filter_editor name="flt_search" label="Filtrar Ambientes" />
        </layout_panel>
        <layout_panel name="list_panel" label="Ambientes">
            <panel name="pnl_inv_wrap" label="pnl_inv_wrap" />
        </layout_panel>
        <layout_panel name="lp_showfolders">
            <check_box name="chk_showfolders" initial_value="false" label="Exibir todas as pastas" />
        </layout_panel>
        <layout_panel name="pnl_control">
            <panel name="pnl_bottom" label="bottom_panel">
                <menu_button name="btn_gear" tool_tip="Mais opções" />
                <menu_button name="btn_newsettings" tool_tip="Criar nova configuração" />
                <button name="btn_del" tool_tip="Remover item selecionado" />
            </panel>
        </layout_panel>
    </layout_stack>
</floater>
