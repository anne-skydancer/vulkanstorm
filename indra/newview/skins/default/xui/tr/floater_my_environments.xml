<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater label="Yerler" name="my_environments" title="ORTAMLARIM">
    <layout_stack name="main_layout">
        <layout_panel name="filter_panel" label="Filtreler">
            <check_box name="chk_days" label="Günler" />
            <check_box name="chk_skies" label="Gökler" />
            <check_box name="chk_water" label="Su" />
            <filter_editor name="flt_search" label="Ortamları Filtrele" />
        </layout_panel>
        <layout_panel name="list_panel" label="Ortamlar">
            <panel name="pnl_inv_wrap" label="pnl_inv_wrap" />
        </layout_panel>
        <layout_panel name="lp_showfolders">
            <check_box name="chk_showfolders" initial_value="false" label="Tüm Klasörleri Göster" />
        </layout_panel>
        <layout_panel name="pnl_control">
            <panel name="pnl_bottom" label="bottom_panel">
                <menu_button name="btn_gear" tool_tip="Diğer seçenekler" />
                <menu_button name="btn_newsettings" tool_tip="Yeni ayar oluştur" />
                <button name="btn_del" tool_tip="Seçilen öğeyi kaldır" />
            </panel>
        </layout_panel>
    </layout_stack>
</floater>
